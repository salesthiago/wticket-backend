PORT=3000
MONGO_URI=mongodb://localhost:27017/wticket
JWT_SECRET=7726fcfe9ea4dcf2748faebceacc1d5c23ba85e76652c191a852e6244350a33a
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:4200
LOG_LEVEL=debug

# ─── Criptografia AES-256-GCM ─────────────────────────────────────────────
# Usada para cifrar: senha do certificado A1 (NFS-e), secretAccessKey das
# configurações de S3 por empresa e os segredos dos provedores de pagamento
# do billing (client_secret/webhook secret do Itaú, certificado + chave mTLS,
# chaves do Stripe). 64 caracteres hex (32 bytes).
# IMPORTANTE: NÃO altere depois de pôr em uso — você perderá acesso aos dados cifrados.
NFSE_CERT_KEY=

# ─── Billing: Itaú (Pix / Pix recorrente) ────────────────────────────────
# Fallback quando não configurado pelo painel super-admin (admin/billing-config).
ITAU_ENV=production
ITAU_CLIENT_ID=
ITAU_CLIENT_SECRET=
# Caminhos de arquivos PEM já presentes no servidor (alternativa ao upload no painel).
ITAU_CERTIFICATE_PATH=
ITAU_PRIVATE_KEY_PATH=
ITAU_WEBHOOK_SECRET=

# ─── Billing: Stripe (cartão — integração futura) ────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Storage S3 padrão (fallback quando empresa não configurar próprio) ───
# Empresas que não habilitarem storageConfig.enabled usarão essas credenciais.
# Substitua os valores REPLACE_ME pelas chaves reais da sua conta AWS IAM.
S3_DEFAULT_BUCKET=
S3_DEFAULT_REGION=sa-east-1
S3_DEFAULT_ACCESS_KEY=
S3_DEFAULT_SECRET_KEY=
# Opcional: prefixo a aplicar dentro do bucket (deixe vazio se não quiser)
S3_DEFAULT_PREFIX=
# Opcional: URL pública (CloudFront ou domínio customizado)
S3_DEFAULT_PUBLIC_BASE_URL=
# Opcional: endpoint customizado (Cloudflare R2, MinIO, DigitalOcean Spaces…)
S3_DEFAULT_ENDPOINT=
S3_DEFAULT_FORCE_PATH_STYLE=false

# ─── E-mail (AWS SES) — fallback quando não configurado pelo painel admin ──
# O painel do super_admin (admin/email-config) permite configurar/ativar em
# runtime; estas variáveis servem apenas de fallback inicial.
SES_REGION=sa-east-1
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_FROM_EMAIL=
SES_FROM_NAME=WTicket